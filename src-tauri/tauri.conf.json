{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "FileHarbor",
  "version": "0.2.0",
  "identifier": "com.fileharbor.app",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:5173",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
"windows": [
      {
        "title": "FileHarbor",
        "width": 1200,
        "height": 800,
        "minWidth": 900,
        "minHeight": 600
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": false,
    "icon": ["icons/icon.ico"]
  }
}

